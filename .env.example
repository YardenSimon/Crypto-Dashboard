# Copy this file to .env and fill in the values.
# DATABASE_URL is overridden inside Docker to use the container hostname.
# Use the localhost version when running the API outside of Docker (e.g. pytest).
DATABASE_URL=postgresql://cryptide:cryptide@localhost:5432/cryptide

JWT_SECRET=change-me-in-production
ENVIRONMENT=development
JWT_ALGORITHM=HS256
COOKIE_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:5173

COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
